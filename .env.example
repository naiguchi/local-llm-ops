# Open WebUI（localhost のみ公開）
OPEN_WEBUI_PORT=3080

# ホストの Ollama（Docker からは host.docker.internal）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# 既定モデル（Open WebUI の日本語優先カスタムモデル）
DEFAULT_MODEL=ops-ja

# ホスト AWS ブリッジ（Open WebUI Tool Server）
OPS_BRIDGE_PORT=3091

# Notes/Calendar/Automations は AWS/DB ツール呼び出しを妨害するため無効推奨
# docker-compose.yml でも ENABLE_NOTES/CALENDAR/AUTOMATIONS=false を設定済み
